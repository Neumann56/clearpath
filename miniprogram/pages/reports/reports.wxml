<view class="wrap">

  <view wx:if="{{loading}}" class="loading">正在取历史…</view>

  <block wx:elif="{{list.length === 0}}">
    <empty-state
      icon="◷"
      text="还没有算过的票。算第一票，它就会出现在这里。历史金额永久冻结，参数库更新也不会改它。"
      action="去算一票"
      bind:act="goNew"
    />
    <view wx:if="{{err}}" class="banner warn">连不上服务器：{{err}}</view>
  </block>

  <block wx:else>
    <view wx:if="{{demoMode}}" class="banner warn">
      连不上服务器，这下面是一条<text style="font-weight:600">演示样例</text>，不是你算过的票。
    </view>

    <view class="ritem" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="open">
      <view class="r1">
        <view class="cn">{{item.country}}</view>
        <view class="hs">{{item.hs}}</view>
        <view class="dot {{item.cls}}"></view>
      </view>
      <view class="r2">
        <view class="c">真实成本<text class="v">{{item.landed}}</text></view>
        <view class="c">需备现金<text class="v">{{item.cash}}</text></view>
      </view>
      <view class="r3">{{item.when}} · {{item.state}}</view>
    </view>
  </block>

</view>
